# Secrets — API keys live in MCP configs OUTSIDE this repo; never commit them.
# This defends against a user dropping keys into a local .env / key file.
.env
.env.*
*.key
*.pem
secrets.json
mcp-config.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Personal data — never publish a real profile, CV or application.
# A workspace belongs OUTSIDE this repo. If one is ever created at the repo root
# by mistake, these keep it out of a commit. Anchored with a leading slash so the
# templates under assets/workspace/ are NOT swept up.
/profile.md
/STATE.md
/dump/
/setup/
/master-cvs/
/jobs/

# Rendered documents (regenerated from markdown by scripts/render_docx.py).
*.docx

# Local Claude session notes — session-continuity docs, never published
*.local.md
PROJECT-STATUS.local.md

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
dist/

# Local agent/session state — never published
.claude/
.claude-flow/

# Working notes from a downstream install — improvements pending review before
# they are written up properly. Never published as-is.
/UPSTREAM-IDEAS.md
